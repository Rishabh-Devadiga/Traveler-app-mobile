# Release/device build default (Vite loads this for `npm run build`).
# A physical phone cannot reach `localhost` (that is the phone itself), so the
# APK must point at the dev PC over LAN. Runtime `public/api-config.json` /
# localStorage override wins when present; this is the baked-in fallback.
VITE_TOURFLOW_API_URL=http://192.168.137.100:8000
