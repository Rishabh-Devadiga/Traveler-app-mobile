# WanderAI Traveler frontend — environment template (no secrets here).
# Copy to `.env` and point at your backend. `.env` files are gitignored.
#
# Base URL of the existing WanderAI backend (scheme + host + port, no /api suffix).
# The app calls POST /api/trips and GET /api/trips/{trip_id} under this base.
# Local backend default (uvicorn backend.main:app, port 8000):
VITE_TOURFLOW_API_URL=http://127.0.0.1:8000 
#
# When unset, the app stays on the built-in mock flow (no backend calls).
#
# Support numbers shown on the Profile → Help & Support sheet (tap-to-call).
# Leave unset to show a "Not configured" state instead of a number.
# VITE_SUPPORT_PHONE_PRIMARY=+911800000001
# VITE_SUPPORT_PHONE_SECONDARY=+911800000002
